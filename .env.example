# --- public (exposed to client) ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Public base URL for S3-compatible storage (MinIO) media (e.g. http://localhost:9000/<bucket>) — no trailing slash
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=
# Canonical origin. Local dev may leave this blank; production should set it to
# the live domain (e.g. https://nomarcprojects.com). It forces resolveSiteUrl()
# even when AUTH_URL/BETTER_AUTH_URL are stale loopback values copied from a dev box.
NEXT_PUBLIC_SITE_URL=

# --- Email (transactional + campaign) ---
# Resend is the email provider.
RESEND_API_KEY=
# Sender override; defaults to EMAIL_FROM ("Name <you@sender-domain>")
RESEND_FROM=
EMAIL_FROM=Nomarc Projects <info@nomarcprojects.com>

# --- server only ---
AUTH_SECRET=change_me_min_16_chars
AUTH_URL=http://localhost:3000

# Google OAuth (Auth.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments — leave blank for demo mode (no real charges). Set a provider's
# secret to go live; PAYMENT_PROVIDER forces a specific one when several are set.
# Multivendor: vendor subaccounts + transaction split settle vendors directly;
# Dedicated Virtual Accounts (per-vendor bank-transfer payin) need DVA activation.
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
SEERBIT_PUBLIC_KEY=
SEERBIT_SECRET_KEY=

# --- Helm (AI consultant) ---
# Two interchangeable backends behind one contract (see lib/helm/backend.ts).
#
# HELM_BACKEND:
#   auto  (default) — use the VM when it's configured, else the local provider
#   vm              — force the self-hosted HELM service
#   local           — force the direct provider call, ignore the VM
# Leave unset while the VM is still being stood up: auto serves the assistant
# from the providers below and hands over to the VM the moment it is reachable.
HELM_BACKEND=

# Backend "vm": the self-hosted Python service. HELM_API_URL is its base URL
# (e.g. the Cloudflare Tunnel origin); HELM_INTERNAL_TOKEN is the shared secret
# it requires. Leave both blank to keep the VM out of the picture.
HELM_API_URL=
HELM_INTERNAL_TOKEN=

# Backend "local": direct calls to OpenAI-compatible providers, tried in
# HELM_BURST_ORDER and failed over on error. Set at least one key. The base URL
# and model default per provider and rarely need changing — the defaults go
# stale, so override the model without a code change when a provider retires one.
HELM_BURST_ORDER=cerebras,groq,sambanova
HELM_CEREBRAS_API_KEY=
# HELM_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# HELM_CEREBRAS_MODEL=llama-3.3-70b
HELM_GROQ_API_KEY=
# HELM_GROQ_BASE_URL=https://api.groq.com/openai/v1
# HELM_GROQ_MODEL=llama-3.3-70b-versatile
HELM_SAMBANOVA_API_KEY=
# HELM_SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
# HELM_SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
